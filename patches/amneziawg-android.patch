+func TestDeviceClosePanicRetainsDeviceAndClosesKnownTUN(t *testing.T) {
+	c := testProtectedContext(8)
+	dev := &fakeOwnedDevice{closed: make(chan struct{}), panicClose: true}
+	base := &fakeCloseTUN{}
+	c.ownedDevice = dev
+	c.ownedTUN = newTrackedTUN(base)
+	c.finishAfterRun(false)
+	if dev.calls != 1 || base.calls != 1 || c.ownedDevice != dev || !c.quarantined { t.Fatal("panic owner not retained/closed safely") }
+	if c.state != pStopping { t.Fatal("cleanup panic reported stopped") }
+	select { case <-c.done: t.Fatal("cleanup panic fabricated completion"); default: }
+}
