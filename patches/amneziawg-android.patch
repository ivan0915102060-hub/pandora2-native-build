+type countedRaw struct { controls int }
+func (r *countedRaw) Control(fn func(uintptr)) error { r.controls++; fn(123); return nil }
+func (*countedRaw) Read(func(uintptr) bool) error { return syscall.EINVAL }
+func (*countedRaw) Write(func(uintptr) bool) error { return syscall.EINVAL }
