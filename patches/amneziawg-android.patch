+func TestTrackedTUNPreservesFirstCloseFailure(t *testing.T) {
+	base := &fakeCloseTUN{err: errors.New("close failed")}
+	tracked := newTrackedTUN(base)
+	tracked.Close(); tracked.Close()
+	if base.calls != 1 || tracked.cleanupConfirmed() { t.Fatal("close failure erased by retry") }
+}
+func TestTrackedTUNRequiresActualCloseBeforeConfirmation(t *testing.T) {
