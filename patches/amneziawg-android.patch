+/* SPDX-License-Identifier: Apache-2.0 */
+package org.pandora.nativebridge;
+
+/** Candidate adapter API, not the stock GoBackend and not qualified Android protection. */
+public final class ProtectedAwgNative {
+    public static final int UNKNOWN = 0, STARTING = 1, RUNNING = 2, STOPPING = 3, STOPPED = 4;
+    private static final long MAX_STOP_WAIT_MS = 5000;
+    private ProtectedAwgNative() {}
+
+    public interface SocketProtector {
+        // Borrowed FD in this JNI process; no retention/close/reentry.
+        // Cross-process implementations must transfer a real PFD and enforce
+        // their own bounded RPC. Never pass a naked fd integer remotely.
+        boolean protect(int borrowedSocketFd);
+    }
+
+    // Caller loads the audited native artifact first; no stock fallback.
+    // borrows the current-process TUN FD, synchronously duplicates it natively.
+    // token=0 means NOT accepted. Positive token means pending, NOT connected.
+    public static long beginAsync(int borrowedTunFd, String settings, SocketProtector protector) {
+        if (borrowedTunFd < 0 || settings == null || protector == null) return 0;
+        if (settings.length() > 262144) return 0;
+        for (int i = 0; i < settings.length(); i++) {
+            char ch = settings.charAt(i);
+            if (ch > 127 || (ch < 32 && ch != '\n' && ch != '\r' && ch != '\t')) return 0;
+        }
+        return nativeBegin(borrowedTunFd, settings, protector);
+    }
+    public static long status(long token) { return nativeStatus(token); }
+    public static int state(long status) { return (int)(status >>> 32); }
+    public static int reason(long status) { return (int)status; }
+    public static void requestStop(long token) { nativeRequestStop(token); }
+
+    /** Bounded caller-side wait. UNKNOWN never frees native refs or owner TUN. */
+    public static long awaitStop(long token, long timeoutMs) {
+        if (token <= 0 || timeoutMs <= 0 || timeoutMs > MAX_STOP_WAIT_MS) return 0;
+        final long deadline = System.nanoTime() + timeoutMs * 1_000_000L;
+        nativeRequestStop(token);
+        for (;;) {
+            long value = nativeStatus(token);
+            if (state(value) == STOPPED) return value;
+            long remaining = deadline - System.nanoTime();
+            if (remaining <= 0) return 0; // Timed out: reserved context remains alive.
+            try {
+                Thread.sleep(Math.max(1, Math.min(10, remaining / 1_000_000L)));
+            } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+                return 0;
+            }
+        }
+    }
+    // Explicit only after STOPPED. False means context is still reserved.
+    public static boolean releaseStopped(long token) { return nativeReleaseStopped(token); }
+
+    private static native long nativeBegin(int tunFd, String settings, SocketProtector protector);
+    private static native long nativeStatus(long token);
+    private static native void nativeRequestStop(long token);
+    private static native boolean nativeReleaseStopped(long token);
+}
