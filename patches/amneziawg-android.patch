+func TestProtectedCancelledCallbackDoesNotBorrowFD(t *testing.T) {
+	c := testProtectedContext(4)
+	c.requestStop()
+	raw := &countedRaw{}
+	if c.protect("udp4", ":0", raw) == nil || raw.controls != 0 { t.Fatal("cancelled callback reached fd") }
