@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: Apache-2.0
+// PANDORA candidate; NOT_QUALIFIED until Go/JNI/Android execution evidence.
+package main
+
+/*
+#include <stdint.h>
+extern int pandora_protect_socket(uint64_t token, int fd);
+*/
+import "C"
+
+import (
+	"errors"
+	"sync"
+	"syscall"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+const (
+	pUnknown = 0
+	pStarting = 1
+	pRunning = 2
+	pStopping = 3
+	pStopped = 4
+)
+const (
+	pOK = 0
+	pCancelled = 1
+	pTunFailed = 2
+	pConfigFailed = 3
+	pProtectFailed = 4
+	pUpFailed = 5
+	pInternalFailed = 6
+	pCleanupUnknown = 7
+)
+
+// Upstream Device.Close discards its TUN Close error. Preserve the FIRST
+// outcome instead of retrying Close (NativeTun has a sync.Once).
+type trackedTUN struct {
+	tun.Device
+	once sync.Once
+	closed chan struct{}
+	known bool
+	err error
+}
+func newTrackedTUN(td tun.Device) *trackedTUN { return &trackedTUN{Device: td, closed: make(chan struct{})} }
+func (t *trackedTUN) Close() error {
+	t.once.Do(func() {
+		defer close(t.closed)
+		t.err = t.Device.Close()
+		t.known = true
+	})
+	return t.err
+}
+func (t *trackedTUN) cleanupConfirmed() bool {
+	select { case <-t.closed: return t.known && t.err == nil; default: return false }
+}
+
+type protectedContext struct {
+	token uint64
+	mu sync.Mutex
+	state int
+	reason int
+	stop chan struct{}
+	stopOnce sync.Once
+	done chan struct{}
+	// Quarantine keeps ownership reachable even if the worker panics or
+	// cleanup cannot be proven. Only the worker attempts cleanup, once.
+	ownedFD int
+	fdPhase string
+	ownedTUN *trackedTUN
+	ownedDevice interface { Close(); Wait() chan struct{} }
+	ownedBind interface { Close() error; CloseFailure() error }
+	constructionCleanupKnown bool
+	quarantined bool
+}
+
+var protectedRegistry struct {
+	sync.Mutex
+	active *protectedContext
+}
+
+func (c *protectedContext) stopping() bool {
+	select { case <-c.stop: return true; default: return false }
+}
+
+func (c *protectedContext) requestStop() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.state == pStopped { return }
+	if c.reason == pOK { c.reason = pCancelled }
+	c.stopOnce.Do(func() { close(c.stop) })
+	c.state = pStopping
+}
+
+func (c *protectedContext) tryRunning() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.stopping() || c.state != pStarting { return false }
+	c.state = pRunning
+	return true
+}
+
+func (c *protectedContext) protect(_ string, _ string, raw syscall.RawConn) error {
+	if c.stopping() { return errors.New("cancelled") }
+	ok := false
+	err := raw.Control(func(fd uintptr) {
+		if !c.stopping() { ok = C.pandora_protect_socket(C.uint64_t(c.token), C.int(fd)) == 1 }
+	})
+	if err != nil || !ok || c.stopping() {
+		if !c.stopping() { c.fail(pProtectFailed) }
+		return errors.New("socket protection unavailable")
+	}
+	return nil
+}
+
+// cleanupOwned runs once on the worker's defer, with no context mutex held
+// across Close/Wait. A blocked close keeps this owner alive. A panic leaves
+// reachable quarantine references and does not produce completion proof.
+func attemptOwnedCleanup(action func() error) (err error) {
+	defer func() { if recover() != nil { err = errors.New("cleanup panicked") } }()
+	return action()
+}
+
+func (c *protectedContext) cleanupOwned() (known bool) {
+	c.mu.Lock()
+	dev, td, b := c.ownedDevice, c.ownedTUN, c.ownedBind
+	known = c.constructionCleanupKnown
+	c.mu.Unlock()
+	ownersKnown := true
+	if dev != nil {
+		if err := attemptOwnedCleanup(func() error { dev.Close(); <-dev.Wait(); return nil }); err != nil {
+			ownersKnown = false
+			// Device.Close panicked; still attempt known bind/TUN owners,
+			// retaining the device ref and UNKNOWN disposition afterwards.
+			if b != nil { attemptOwnedCleanup(b.Close) }
+			if td != nil { attemptOwnedCleanup(td.Close) }
+		}
+	} else {
+		if b != nil { if err := attemptOwnedCleanup(b.Close); err != nil { ownersKnown = false } }
+		if td != nil { if err := attemptOwnedCleanup(td.Close); err != nil { ownersKnown = false } }
+	}
+	if td != nil { known = td.cleanupConfirmed() }
+	if b != nil && b.CloseFailure() != nil { known = false }
+	return known && ownersKnown
+}
+
+func (c *protectedContext) finishAfterRun(panicked bool) {
+	if panicked {
+		c.mu.Lock(); c.quarantined = true; c.mu.Unlock()
+		c.fail(pInternalFailed)
+	}
+	// A recovered run panic must still attempt Close on the known live owner.
+	// Even if that attempt returns cleanly, panic disposition remains UNKNOWN.
+	known := c.cleanupOwned()
+	if !known || panicked {
+		c.mu.Lock(); c.quarantined = true; c.mu.Unlock()
+		c.fail(pCleanupUnknown)
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.quarantined || c.state == pStopped { return }
+	if c.stopping() && c.reason == pOK { c.reason = pCancelled }
+	c.fdPhase = "CLOSED_CONFIRMED"
+	c.state = pStopped
+	close(c.done)
+}
+
+// Only this worker owns cleanup. Context retains each owner before operations
+// capable of failing after a device has started; no other goroutine retries it.
+func (c *protectedContext) run(fd int, settings string) {
+	defer func() { c.finishAfterRun(recover() != nil) }()
+	c.mu.Lock(); c.fdPhase = "CONSUMING"; c.mu.Unlock()
+	rawTUN, _, err := tun.ConsumeUnmonitoredTUNFromFD(fd)
+	if err != nil {
+		c.mu.Lock()
+		c.constructionCleanupKnown = tun.OwnedTUNFailureCleanupConfirmed(err)
+		c.fdPhase = "CONSUME_FAILED"
+		c.mu.Unlock()
+		c.fail(pTunFailed)
+		return
+	}
+	td := newTrackedTUN(rawTUN)
+	c.mu.Lock(); c.ownedTUN = td; c.fdPhase = "TUN_OWNED"; c.mu.Unlock()
+	if c.stopping() { return }
+	b, err := conn.NewStdNetBindWithSocketControl(c.protect)
+	if err != nil { c.fail(pProtectFailed); return }
+	c.mu.Lock(); c.ownedBind = b.(interface { Close() error; CloseFailure() error }); c.mu.Unlock()
+	logger := &device.Logger{Verbosef: func(string, ...interface{}) {}, Errorf: func(string, ...interface{}) {}}
+	dev := device.NewDevice(td, b, logger)
+	c.mu.Lock(); c.ownedDevice = dev; c.mu.Unlock()
+	if err = dev.IpcSet(settings); err != nil { c.fail(pConfigFailed); return }
+	if c.stopping() { return }
+	dev.DisableSomeRoamingForBrokenMobileSemantics()
+	if err = dev.Up(); err != nil { c.fail(pUpFailed); return }
+	if !c.tryRunning() { return }
+	<-c.stop
+}
+
+func (c *protectedContext) fail(reason int) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.state == pStopped { return }
+	if c.reason == pOK { c.reason = reason }
+	// Wake the worker on a RUNNING rebind failure, but never synchronously
+	// Close from inside a socket control callback (would invert bind locks).
+	c.stopOnce.Do(func() { close(c.stop) })
+	c.state = pStopping
+}
+
+//export pandoraAwgBegin
+func pandoraAwgBegin(token C.uint64_t, fd C.int, settings *C.char) C.int {
+	if token == 0 || fd < 0 || settings == nil { return -1 }
+	protectedRegistry.Lock()
+	defer protectedRegistry.Unlock()
+	if protectedRegistry.active != nil { return -1 }
+	c := &protectedContext{token: uint64(token), state: pStarting, stop: make(chan struct{}), done: make(chan struct{}), ownedFD: int(fd), fdPhase: "ACCEPTED"}
+	config := C.GoString(settings) // Copy synchronously before JNI releases UTF chars.
+	protectedRegistry.active = c
+	go c.run(int(fd), config)
+	return 0 // fd ownership transferred; NO claim that Up has completed.
+}
+
+func findProtected(token uint64) *protectedContext {
+	protectedRegistry.Lock()
+	defer protectedRegistry.Unlock()
+	c := protectedRegistry.active
+	if c == nil || c.token != token { return nil }
+	return c
+}
+
+//export pandoraAwgStatus
+func pandoraAwgStatus(token C.uint64_t) C.uint64_t {
+	c := findProtected(uint64(token))
+	if c == nil { return 0 }
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return C.uint64_t(uint64(c.state)<<32 | uint64(c.reason))
+}
+
+//export pandoraAwgRequestStop
+func pandoraAwgRequestStop(token C.uint64_t) {
+	if c := findProtected(uint64(token)); c != nil { c.requestStop() }
+}
+
+//export pandoraAwgRelease
+func pandoraAwgRelease(token C.uint64_t) C.int {
+	protectedRegistry.Lock()
+	defer protectedRegistry.Unlock()
+	c := protectedRegistry.active
+	if c == nil || c.token != uint64(token) { return 0 }
+	select {
+	case <-c.done:
+		protectedRegistry.active = nil
+		return 1
+	default:
+		return 0
+	}
+}
