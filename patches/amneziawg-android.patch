+func testProtectedContext(token uint64) *protectedContext {
+	return &protectedContext{token: token, state: pStarting, stop: make(chan struct{}), done: make(chan struct{})}
+}
+
+func TestProtectedStopBeforeUpNeverBecomesRunning(t *testing.T) {
+	c := testProtectedContext(1)
+	c.requestStop()
+	if c.tryRunning() || c.state != pStopping { t.Fatal("late Up revived cancelled start") }
+}
+
+func TestProtectedConcurrentStopIsIdempotent(t *testing.T) {
+	c := testProtectedContext(2)
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ { wg.Add(1); go func() { defer wg.Done(); c.requestStop() }() }
+	wg.Wait()
+	if !c.stopping() || c.state != pStopping { t.Fatal("stop did not latch") }
+}
+
+func TestProtectedRunningDoesNotClearStop(t *testing.T) {
+	c := testProtectedContext(3)
+	if !c.tryRunning() { t.Fatal("start transition rejected") }
+	c.requestStop()
+	if c.tryRunning() || !c.stopping() { t.Fatal("cancelled core became running") }
+}
+
+func TestProtectedReleaseRequiresActualCompletion(t *testing.T) {
+	c := testProtectedContext(99)
+	protectedRegistry.Lock(); protectedRegistry.active = c; protectedRegistry.Unlock()
+	t.Cleanup(func() { protectedRegistry.Lock(); protectedRegistry.active = nil; protectedRegistry.Unlock() })
+	c.requestStop()
+	if pandoraAwgRelease(99) != 0 || findProtected(99) == nil { t.Fatal("released pending cleanup") }
+	c.mu.Lock(); c.state = pStopped; close(c.done); c.mu.Unlock()
+	if pandoraAwgRelease(99) != 1 || findProtected(99) != nil { t.Fatal("completed context not released") }
+}
