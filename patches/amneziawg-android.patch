+func TestRecoveredLiveDevicePanicStillAttemptsOwnedCleanup(t *testing.T) {
+	c := testProtectedContext(7)
+	dev := &fakeOwnedDevice{closed: make(chan struct{})}
+	tdBase := &fakeCloseTUN{}
+	c.ownedDevice = dev
+	c.ownedTUN = newTrackedTUN(tdBase)
+	// Fake device has no real TUN: Close is independently recorded below.
+	// For a real device it calls trackedTUN.Close as part of upstream Close.
+	c.ownedTUN.Close()
+	c.finishAfterRun(true)
+	if dev.calls != 1 || !c.quarantined || c.state != pStopping { t.Fatal("panic skipped live owner cleanup") }
+	if c.ownedDevice != dev || c.ownedTUN == nil { t.Fatal("quarantine ownership lost") }
+	select { case <-c.done: t.Fatal("panic fabricated completion proof"); default: }
+}
