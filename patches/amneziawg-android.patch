+/* SPDX-License-Identifier: Apache-2.0 */
+/* Candidate bridge, not a qualified binary. No retained JNIEnv or naked
+ * cross-process descriptor. Callback must synchronously protect borrowed fd. */
+#include <jni.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <limits.h>
+
+extern int pandoraAwgBegin(uint64_t, int, char *);
+extern uint64_t pandoraAwgStatus(uint64_t);
+extern void pandoraAwgRequestStop(uint64_t);
+extern int pandoraAwgRelease(uint64_t);
+
+struct protection_context {
+    uint64_t token;
+    JavaVM *vm;
+    jobject callback; /* global ref, retained through full native completion */
+    jmethodID protect;
+    unsigned int inflight;
+};
+static pthread_mutex_t protection_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct protection_context *active_context;
+static uint64_t next_token = 1; /* Never reused in this process. Exhaustion fails. */
+
+static void clear_exception(JNIEnv *env) {
+    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+}
+
+int pandora_protect_socket(uint64_t token, int fd) {
+    struct protection_context *ctx;
+    pthread_mutex_lock(&protection_lock);
+    ctx = active_context;
+    if (!ctx || ctx->token != token || fd < 0) {
+        pthread_mutex_unlock(&protection_lock);
+        return 0;
+    }
+    ++ctx->inflight;
+    pthread_mutex_unlock(&protection_lock);
+
+    JNIEnv *env = NULL;
+    int attached = 0, ok = 0;
+    jint result = (*ctx->vm)->GetEnv(ctx->vm, (void **)&env, JNI_VERSION_1_6);
+    if (result == JNI_EDETACHED) {
+        if ((*ctx->vm)->AttachCurrentThread(ctx->vm, &env, NULL) != JNI_OK) goto finished;
+        attached = 1;
+    } else if (result != JNI_OK) goto finished;
+    if ((*env)->ExceptionCheck(env)) { clear_exception(env); goto detach; }
+    ok = (*env)->CallBooleanMethod(env, ctx->callback, ctx->protect, (jint)fd) == JNI_TRUE;
+    if ((*env)->ExceptionCheck(env)) { clear_exception(env); ok = 0; }
+detach:
+    if (attached && (*ctx->vm)->DetachCurrentThread(ctx->vm) != JNI_OK) ok = 0;
+finished:
+    pthread_mutex_lock(&protection_lock);
+    --ctx->inflight;
+    pthread_mutex_unlock(&protection_lock);
+    return ok;
+}
+
+JNIEXPORT jlong JNICALL Java_org_pandora_nativebridge_ProtectedAwgNative_nativeBegin(
+        JNIEnv *env, jclass ignored, jint borrowed_tun_fd, jstring settings, jobject protector) {
+    (void)ignored;
+    if (borrowed_tun_fd < 0 || !settings || !protector) return 0;
+    if ((*env)->GetStringUTFLength(env, settings) > 262144) return 0;
+    pthread_mutex_lock(&protection_lock);
+    if (active_context || next_token > INT64_MAX) { pthread_mutex_unlock(&protection_lock); return 0; }
+    struct protection_context *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx) { pthread_mutex_unlock(&protection_lock); return 0; }
+    int owned_fd = -1;
+    const char *config = NULL;
+    jclass callback_class = NULL;
+    if ((*env)->GetJavaVM(env, &ctx->vm) != JNI_OK) goto failed;
+    callback_class = (*env)->GetObjectClass(env, protector);
+    if (!callback_class) goto failed;
+    ctx->protect = (*env)->GetMethodID(env, callback_class, "protect", "(I)Z");
+    (*env)->DeleteLocalRef(env, callback_class);
+    callback_class = NULL;
+    if (!ctx->protect || (*env)->ExceptionCheck(env)) goto failed;
+    ctx->callback = (*env)->NewGlobalRef(env, protector);
+    if (!ctx->callback) goto failed;
+    config = (*env)->GetStringUTFChars(env, settings, NULL);
+    if (!config) goto failed;
+    /* JNI is modified UTF-8. This entry accepts ASCII UAPI only, so bytes
+     * are unambiguous; reject NUL/non-ASCII instead of silently transcoding. */
+    jsize config_length = (*env)->GetStringUTFLength(env, settings);
+    for (jsize i = 0; i < config_length; ++i) {
+        unsigned char ch = (unsigned char)config[i];
+        if (ch > 127 || (ch < 32 && ch != '\n' && ch != '\r' && ch != '\t')) goto failed;
+    }
+    /* Owner's original descriptor stays open. Transfer this duplicate only. */
+    owned_fd = fcntl(borrowed_tun_fd, F_DUPFD_CLOEXEC, 0);
+    if (owned_fd < 0) goto failed;
+    ctx->token = next_token++;
+    active_context = ctx;
+    /* Begin only reserves/copies arguments and launches a Go worker; it must
+     * not synchronously invoke the Java protector while this lock is held. */
+    int accepted = pandoraAwgBegin(ctx->token, owned_fd, (char *)config);
+    (*env)->ReleaseStringUTFChars(env, settings, config);
+    config = NULL;
+    if (accepted != 0) { active_context = NULL; goto failed; }
+    owned_fd = -1; /* Go worker is now the sole owner, including failure paths. */
+    jlong token = (jlong)ctx->token;
+    pthread_mutex_unlock(&protection_lock);
+    return token;
+failed:
+    clear_exception(env);
+    if (config) (*env)->ReleaseStringUTFChars(env, settings, config);
+    if (callback_class) (*env)->DeleteLocalRef(env, callback_class);
+    if (owned_fd >= 0) close(owned_fd);
+    if (ctx->callback) (*env)->DeleteGlobalRef(env, ctx->callback);
+    free(ctx);
+    pthread_mutex_unlock(&protection_lock);
+    return 0;
+}
+
+JNIEXPORT jlong JNICALL Java_org_pandora_nativebridge_ProtectedAwgNative_nativeStatus(
+        JNIEnv *env, jclass ignored, jlong token) {
+    (void)env; (void)ignored;
+    if (token <= 0) return 0;
+    uint64_t value = pandoraAwgStatus((uint64_t)token);
+    pthread_mutex_lock(&protection_lock);
+    struct protection_context *ctx = active_context;
+    if (!ctx || ctx->token != (uint64_t)token) value = 0;
+    else if ((value >> 32) == 4 && ctx->inflight != 0)
+        value = ((uint64_t)3 << 32) | (value & UINT32_MAX);
+    pthread_mutex_unlock(&protection_lock);
+    return (jlong)value;
+}
+
+JNIEXPORT void JNICALL Java_org_pandora_nativebridge_ProtectedAwgNative_nativeRequestStop(
+        JNIEnv *env, jclass ignored, jlong token) {
+    (void)env; (void)ignored;
+    if (token > 0) pandoraAwgRequestStop((uint64_t)token);
+}
+
+JNIEXPORT jboolean JNICALL Java_org_pandora_nativebridge_ProtectedAwgNative_nativeReleaseStopped(
+        JNIEnv *env, jclass ignored, jlong token) {
+    (void)ignored;
+    if (token <= 0) return JNI_FALSE;
+    /* No JNI callback can begin again once Go reports true completion.
+     * Do not hold the C mutex while waiting for Go/device shutdown. */
+    uint64_t value = pandoraAwgStatus((uint64_t)token);
+    if ((value >> 32) != 4) return JNI_FALSE;
+    pthread_mutex_lock(&protection_lock);
+    struct protection_context *ctx = active_context;
+    if (!ctx || ctx->token != (uint64_t)token || ctx->inflight != 0) {
+        pthread_mutex_unlock(&protection_lock); return JNI_FALSE;
+    }
+    if (!pandoraAwgRelease((uint64_t)token)) {
+        pthread_mutex_unlock(&protection_lock); return JNI_FALSE;
+    }
+    active_context = NULL;
+    (*env)->DeleteGlobalRef(env, ctx->callback);
+    free(ctx);
+    pthread_mutex_unlock(&protection_lock);
+    return JNI_TRUE;
+}
