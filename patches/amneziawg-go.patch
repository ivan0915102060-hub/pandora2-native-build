--- /dev/null
+++ b/candidate/amneziawg-go/tun/tun_owned_linux.go
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+// Derived from the pinned tun_linux.go constructor; ownership is explicit.
+// Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+package tun
+
+import (
+	"errors"
+	"os"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"golang.org/x/sys/unix"
+)
+
+type ownedTUNCreateError struct { cause error; cleanup error }
+func (e *ownedTUNCreateError) Error() string { return "owned TUN creation failed" }
+func (e *ownedTUNCreateError) Unwrap() error { return e.cause }
+
+// Missing/foreign error types provide no proof of owned-descriptor cleanup.
+func OwnedTUNFailureCleanupConfirmed(err error) bool {
+	var failure *ownedTUNCreateError
+	return errors.As(err, &failure) && failure.cleanup == nil
+}
+
+// ConsumeUnmonitoredTUNFromFD consumes fd on BOTH success and failure.
+// The caller must transfer a dedicated duplicate, never the VPN owner's fd.
+func ConsumeUnmonitoredTUNFromFD(fd int) (Device, string, error) {
+	if err := unix.SetNonblock(fd, true); err != nil {
+		closed := unix.Close(fd)
+		return nil, "", &ownedTUNCreateError{cause: err, cleanup: closed}
+	}
+	file := os.NewFile(uintptr(fd), "/dev/tun")
+	if file == nil {
+		closed := unix.Close(fd)
+		return nil, "", &ownedTUNCreateError{cause: errors.New("invalid owned TUN descriptor"), cleanup: closed}
+	}
+	t := &NativeTun{
+		tunFile: file,
+		events: make(chan Event, 5),
+		errors: make(chan error, 5),
+		tcpGROTable: newTCPGROTable(),
+		udpGROTable: newUDPGROTable(),
+		toWrite: make([]int, 0, conn.IdealBatchSize),
+	}
+	name, err := t.Name()
+	if err != nil { return nil, "", &ownedTUNCreateError{cause: err, cleanup: t.Close()} }
+	if err = t.initFromFlags(name); err != nil { return nil, "", &ownedTUNCreateError{cause: err, cleanup: t.Close()} }
+	return t, name, nil
+}
