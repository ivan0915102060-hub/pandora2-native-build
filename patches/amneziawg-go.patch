new file mode 100644
index 0000000..fc0693f
--- /dev/null
+++ b/candidate/amneziawg-go/tun/tun_owned_linux_test.go
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+package tun
+
+import (
+	"os"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+// A pipe is not a TUN: Name/ioctl must fail. The native duplicate is closed,
+// while the owner's separate fd remains usable. No VPN/device is created.
+func TestOwnedTUNFailureClosesDuplicateNotOwner(t *testing.T) {
+	r, w, err := os.Pipe()
+	if err != nil { t.Fatal(err) }
+	defer r.Close(); defer w.Close()
+	dup, err := unix.Dup(int(r.Fd()))
+	if err != nil { t.Fatal(err) }
+	if td, _, err := ConsumeUnmonitoredTUNFromFD(dup); err == nil || td != nil { t.Fatal("pipe accepted as TUN") }
+	if _, err = unix.FcntlInt(uintptr(dup), unix.F_GETFD, 0); err != unix.EBADF { t.Fatal("duplicate not closed", err) }
+	if _, err = unix.FcntlInt(r.Fd(), unix.F_GETFD, 0); err != nil { t.Fatal("owner fd was closed", err) }
+}
