diff --git a/candidate/amneziawg-go/conn/protected_bind.go b/candidate/amneziawg-go/conn/protected_bind.go
new file mode 100644
index 0000000..eea3097
--- /dev/null
+++ b/candidate/amneziawg-go/conn/protected_bind.go
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: MIT
+// PANDORA candidate: per-instance socket control, not Android qualification.
+package conn
+
+import (
+	"errors"
+	"net"
+	"syscall"
+)
+
+// Caller holds s.mu (Open/Close). Never clear a previous uncertain close.
+func (s *StdNetBind) rememberCloseError(err error) {
+	if s.closeFailure == nil && err != nil { s.closeFailure = err }
+}
+func (s *StdNetBind) CloseFailure() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.closeFailure
+}
+
+// NewStdNetBindWithSocketControl requires a synchronous, non-reentrant control.
+// The callback runs before bind for EVERY socket created by this bind instance.
+// It borrows RawConn only for the duration of this call; it must not close it.
+// Missing/failed protection is fatal; never fall back to NewStdNetBind.
+func NewStdNetBindWithSocketControl(control func(string, string, syscall.RawConn) error) (Bind, error) {
+	if control == nil {
+		return nil, errors.New("socket protection callback required")
+	}
+	b := NewStdNetBind().(*StdNetBind)
+	b.socketControl = control
+	return b, nil
+}
+
+func withSocketControl(base *net.ListenConfig, protect func(string, string, syscall.RawConn) error) *net.ListenConfig {
+	lc := *base
+	prior := base.Control
+	lc.Control = func(network, address string, raw syscall.RawConn) error {
+		if prior != nil {
+			if err := prior(network, address, raw); err != nil {
+				return err
+			}
+		}
+		if protect == nil {
+			return errors.New("socket protection callback missing")
+		}
+		if err := protect(network, address, raw); err != nil {
+			// Deliberately do NOT wrap: callback EAFNOSUPPORT/EADDRINUSE must
+			// not become an optional-family skip or the Open retry condition.
+			// Do not leak callback/JNI exception details into core logs.
+			return errors.New("socket protection failed")
+		}
+		return nil
+	}
+	return &lc
+}
diff --git a/candidate/amneziawg-go/conn/protected_bind_test.go b/candidate/amneziawg-go/conn/protected_bind_test.go
new file mode 100644
index 0000000..d1983b2
--- /dev/null
+++ b/candidate/amneziawg-go/conn/protected_bind_test.go
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: MIT
+package conn
+
+import (
+	"errors"
+	"net"
+	"reflect"
+	"syscall"
+	"testing"
+)
+
+func TestProtectedBindMissingCallback(t *testing.T) {
+	if b, err := NewStdNetBindWithSocketControl(nil); err == nil || b != nil {
+		t.Fatal("missing callback accepted")
+	}
+}
+
+func TestSocketControlOrderAndPerInstance(t *testing.T) {
+	var calls []string
+	base := &net.ListenConfig{Control: func(string, string, syscall.RawConn) error {
+		calls = append(calls, "platform")
+		return nil
+	}}
+	lc := withSocketControl(base, func(string, string, syscall.RawConn) error {
+		calls = append(calls, "protect")
+		return nil
+	})
+	if err := lc.Control("udp4", ":0", nil); err != nil { t.Fatal(err) }
+	if !reflect.DeepEqual(calls, []string{"platform", "protect"}) { t.Fatal(calls) }
+	calls = nil
+	if err := base.Control("udp4", ":0", nil); err != nil { t.Fatal(err) }
+	if !reflect.DeepEqual(calls, []string{"platform"}) { t.Fatal("global config mutated") }
+}
+
+func TestProtectionErrorCannotMasqueradeAsOptionalFamily(t *testing.T) {
+	lc := withSocketControl(&net.ListenConfig{}, func(string, string, syscall.RawConn) error {
+		return syscall.EAFNOSUPPORT
+	})
+	err := lc.Control("udp6", ":0", nil)
+	if err == nil || errors.Is(err, syscall.EAFNOSUPPORT) { t.Fatal("callback failure bypassable", err) }
+}
+
+// These tests use real LOCAL UDP sockets only; they send no datagrams.
+// They are NOT Android/native/protect tests and are NOT_RUN in this package.
+func TestBindProtectFailureLeavesNoSockets(t *testing.T) {
+	b0, err := NewStdNetBindWithSocketControl(func(string, string, syscall.RawConn) error {
+		return errors.New("denied")
+	})
+	if err != nil { t.Fatal(err) }
+	b := b0.(*StdNetBind)
+	defer b.Close()
+	if _, _, err = b.Open(0); err == nil { t.Fatal("Open succeeded without protection") }
+	if b.ipv4 != nil || b.ipv6 != nil { t.Fatal("socket retained after failure") }
+}
+
+func TestBindReopenProtectsAgain(t *testing.T) {
+	calls := 0
+	b, err := NewStdNetBindWithSocketControl(func(string, string, syscall.RawConn) error {
+		calls++
+		return nil
+	})
+	if err != nil { t.Fatal(err) }
+	defer b.Close()
+	if _, _, err = b.Open(0); err != nil { t.Fatal(err) }
+	first := calls
+	if first == 0 { t.Fatal("callback absent on first open") }
+	if err = b.Close(); err != nil { t.Fatal(err) }
+	if _, _, err = b.Open(0); err != nil { t.Fatal(err) }
+	if calls <= first { t.Fatal("reopen reused old protection") }
+}
+
+func TestSecondFamilyProtectFailureClosesFirst(t *testing.T) {
+	seen4 := false
+	b0, err := NewStdNetBindWithSocketControl(func(network, _ string, _ syscall.RawConn) error {
+		if network == "udp4" { seen4 = true; return nil }
+		return errors.New("second family denied")
+	})
+	if err != nil { t.Fatal(err) }
+	b := b0.(*StdNetBind)
+	defer b.Close()
+	if _, _, err = b.Open(0); err == nil { t.Fatal("second family failure accepted") }
+	if !seen4 { t.Fatal("test platform did not exercise first family") }
+	if b.ipv4 != nil || b.ipv6 != nil { t.Fatal("partial socket publication") }
+}
+
+func TestBindCloseFailureSurvivesSecondClose(t *testing.T) {
+	sock, err := net.ListenUDP("udp4", &net.UDPAddr{})
+	if err != nil { t.Fatal(err) }
+	b := NewStdNetBind().(*StdNetBind)
+	b.ipv4 = sock
+	if err = sock.Close(); err != nil { t.Fatal(err) }
+	if b.Close() == nil { t.Fatal("uncertain close not surfaced") }
+	b.Close()
+	if b.CloseFailure() == nil { t.Fatal("second close erased failure") }
+}
